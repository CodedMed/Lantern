{
  "expo": {
    "name": "Lantern",
    "slug": "lantern",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lantern.app"
    },
    "android": {
      "package": "com.lantern.app",
      "permissions": ["CAMERA"]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Lantern to identify common objects in camera images.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
